{{!< default}}

{{#post}}

<main class="gh-main quichi-post-page">

    <span hidden>{{@custom.email_signup_text}}</span>

    <section class="quichi-post-hero gh-outer {{#if feature_image}}has-image{{/if}}">
        {{#if feature_image}}
            <img
                class="quichi-post-hero-image"
                src="{{img_url feature_image size="xl" format="webp"}}"
                srcset="{{img_url feature_image size="s" format="webp"}} 300w, {{img_url feature_image size="m" format="webp"}} 720w, {{img_url feature_image size="xl" format="webp"}} 1200w"
                sizes="100vw"
                fetchpriority="high"
                decoding="async"
                alt="{{title}}"
            >
        {{/if}}

        <div class="quichi-post-hero-overlay"></div>

        <div class="gh-inner quichi-post-hero-inner">
            <nav class="quichi-post-breadcrumb" aria-label="Breadcrumb">
                <a href="{{@site.url}}">Inicio</a>
                {{#primary_tag}}
                    <span>/</span>
                    <a href="{{url}}">{{name}}</a>
                {{/primary_tag}}
                <span>/</span>
                <span>{{title}}</span>
            </nav>

            <div class="quichi-post-kicker">
                {{#primary_tag}}
                    <a href="{{url}}">{{name}}</a>
                {{/primary_tag}}
            </div>

            <div class="quichi-post-classification">
                <span data-quichi-hero-meta-label></span>
                <strong data-quichi-hero-meta-value></strong>
            </div>

            <h1>{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="quichi-hero-excerpt">{{custom_excerpt}}</p>
            {{else}}
                <p class="quichi-hero-excerpt">{{excerpt words="24"}}</p>
            {{/if}}

            <div class="quichi-post-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
            </div>

            <div class="quichi-episode-actions">
            <div class="quichi-post-hero-actions">
                <a href="#quichi-platform-title" class="quichi-button">Ver episodio</a>
                <a href="#quichi-audio" class="quichi-outline-button">Escuchar audio</a>
            </div>
            <div class="quichi-share-wrap" hidden>
                <button class="quichi-outline-button quichi-share-button" type="button" aria-haspopup="dialog" aria-controls="quichi-share-menu">Compartir relato</button>
                <dialog id="quichi-share-menu" class="quichi-share-menu" aria-labelledby="quichi-share-title">
                    <div class="quichi-share-heading"><div><p class="quichi-share-eyebrow">COMPARTE EL MISTERIO</p><h2 id="quichi-share-title">Comparte este relato</h2></div><button class="quichi-share-close" type="button" aria-label="Cerrar">×</button></div>
                    <p class="quichi-share-intro">Elige cómo quieres compartir esta historia.</p>
                    <a class="quichi-share-option" data-share-facebook target="_blank" rel="noopener noreferrer"><span class="quichi-share-option-label"><span class="quichi-share-icon" aria-hidden="true">{{> "icons/facebook"}}</span>Facebook</span><span class="quichi-share-arrow" aria-hidden="true">→</span></a>
                    <button class="quichi-share-option" type="button" data-share-app="Instagram"><span class="quichi-share-option-label"><span class="quichi-share-icon" aria-hidden="true">{{> "icons/instagram"}}</span>Instagram</span><span class="quichi-share-arrow" aria-hidden="true">→</span></button>
                    <button class="quichi-share-option" type="button" data-share-app="TikTok"><span class="quichi-share-option-label"><span class="quichi-share-icon" aria-hidden="true">{{> "icons/tiktok"}}</span>TikTok</span><span class="quichi-share-arrow" aria-hidden="true">→</span></button>
                    <button class="quichi-share-option" type="button" data-share-app="YouTube"><span class="quichi-share-option-label"><span class="quichi-share-icon" aria-hidden="true">{{> "icons/youtube"}}</span>YouTube</span><span class="quichi-share-arrow" aria-hidden="true">→</span></button>
                    <button class="quichi-share-option quichi-share-copy" type="button" data-share-copy><span class="quichi-share-option-label"><span class="quichi-share-icon" aria-hidden="true">⧉</span>Copiar enlace</span><span class="quichi-share-arrow" aria-hidden="true">→</span></button>
                    <p class="quichi-share-status" role="status" aria-live="polite"></p>
                    <label class="quichi-share-manual" hidden>Enlace del episodio<input type="text" readonly aria-label="Enlace del episodio"></label>
                </dialog>
            </div>
            {{> "components/saved-episode-control"}}
            {{> "components/reading-resume-control"}}
            </div>
            <style>
                @media(min-width:768px){body.post-template .quichi-post-hero-image{filter:blur(.35px) brightness(1.4534) contrast(1.08)!important}body.post-template .quichi-post-hero-overlay{background:linear-gradient(90deg,rgba(0,0,0,.86),rgba(0,0,0,.32),rgba(0,0,0,.88)),linear-gradient(180deg,rgba(0,0,0,.08),rgba(5,5,5,.8))!important}}
                @media(max-width:767px){body.post-template .quichi-post-hero-image{filter:brightness(3.042) contrast(1.05)!important}}
                .quichi-episode-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 12px;width:min(100%,510px);margin-top:20px}
                .quichi-episode-actions .quichi-post-hero-actions{grid-column:1/-1;display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px!important;margin:0!important}
                .quichi-episode-actions .quichi-post-hero-actions a,.quichi-episode-actions .quichi-share-button,.quichi-episode-actions .qsave-toggle,.quichi-episode-actions .qresume-button{box-sizing:border-box;display:flex!important;align-items:center;justify-content:center;width:100%!important;min-height:48px!important;margin:0!important;padding:10px 12px!important;text-align:center;white-space:normal}
                .quichi-episode-actions .quichi-share-wrap,.quichi-episode-actions .qsave-control,.quichi-episode-actions .qresume{margin:0!important;min-width:0}
                .quichi-episode-actions .qsave-list-link{margin:4px 0 0;min-height:36px;font-size:12px}
                .quichi-episode-actions .qresume{grid-column:1/-1}
                .quichi-episode-actions .qresume p{margin:5px 0 0;font-size:13px}
                @media(max-width:380px){.quichi-episode-actions{grid-template-columns:1fr}.quichi-episode-actions .quichi-post-hero-actions,.quichi-episode-actions .qresume{grid-column:1}.quichi-episode-actions .quichi-post-hero-actions{grid-template-columns:1fr}}
                .quichi-share-wrap{margin-top:12px}.quichi-share-button{cursor:pointer;font-family:inherit}.quichi-share-menu{box-sizing:border-box;width:min(560px,calc(100vw - 32px));max-height:calc(100dvh - 32px);overflow:auto;margin:auto;padding:32px;background:#120f10;color:#fff;border:1px solid #713b40;border-radius:10px;box-shadow:0 18px 60px #000b}.quichi-share-menu::backdrop{background:rgba(0,0,0,.82)}.quichi-share-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.quichi-share-heading .quichi-share-eyebrow{margin:0 0 12px;color:#ff7777;font:700 11px/1.4 system-ui,sans-serif;letter-spacing:.15em}.quichi-share-heading h2{margin:0;color:#f5f1ef!important;font:400 clamp(28px,4vw,36px)/1.12 Georgia,serif}.quichi-share-close{flex:none;width:44px;height:44px;border:1px solid #73444a;border-radius:50%;background:#211719;color:#fff;font:24px system-ui;cursor:pointer}.quichi-share-intro{margin:12px 0 23px;color:#cdbfc0;font:16px/1.45 Georgia,serif}.quichi-share-option{box-sizing:border-box;display:flex;width:100%;justify-content:space-between;align-items:center;gap:12px;min-height:57px;margin-top:9px;padding:12px 16px;border:1px solid #54343a;border-radius:6px;background:#1d1719;color:#fff!important;text-decoration:none;text-align:left;font:700 14px system-ui,sans-serif;cursor:pointer}.quichi-share-option:hover,.quichi-share-option:focus-visible{background:#2a1a1d}.quichi-share-option-label{display:flex;align-items:center;gap:16px}.quichi-share-icon{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;color:#f4e9e9;font-size:23px}.quichi-share-icon svg{width:22px;height:22px}.quichi-share-arrow{color:#ff7777;font-size:18px}.quichi-share-copy{background:#a30d1c;border-color:#da414e}.quichi-share-copy:hover,.quichi-share-copy:focus-visible{background:#bf182a}.quichi-share-status{margin:12px 0 0;color:#fff;font:14px/1.4 system-ui,sans-serif}.quichi-share-status:empty{display:none}.quichi-share-manual{display:block;color:#fff;font:14px system-ui,sans-serif;margin-top:10px}.quichi-share-manual[hidden]{display:none}.quichi-share-manual input{display:block;box-sizing:border-box;width:100%;margin-top:6px;padding:9px;color:#fff;background:#111;border:1px solid #999;font:14px system-ui,sans-serif}.quichi-share-button:focus-visible,.quichi-share-option:focus-visible,.quichi-share-close:focus-visible,.quichi-share-manual input:focus-visible{outline:3px solid #fff;outline-offset:3px}@media(max-width:767px){.quichi-share-button{width:100%}.quichi-share-menu{padding:22px}.quichi-share-intro{margin-bottom:15px}.quichi-share-option{min-height:50px}}
            </style>
            <script>
            (function(){
              var wrap=document.querySelector('.quichi-share-wrap'); if(!wrap)return;
              var button=wrap.querySelector('.quichi-share-button'), menu=wrap.querySelector('.quichi-share-menu'), status=wrap.querySelector('.quichi-share-status'), manual=wrap.querySelector('.quichi-share-manual'), input=manual.querySelector('input');
              if(typeof menu.showModal!=='function')return;
              var canonical=document.querySelector('link[rel="canonical"]'), url=canonical ? canonical.href : location.origin+location.pathname;
              var heading=document.querySelector('.quichi-post-hero h1'), title=heading?heading.textContent.trim():document.title;
              wrap.querySelector('[data-share-facebook]').href='https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(url);
              wrap.hidden=false;
              button.addEventListener('click',function(){status.textContent='';manual.hidden=true;menu.showModal();});
              menu.querySelector('.quichi-share-close').addEventListener('click',function(){menu.close();});
              menu.addEventListener('click',function(event){if(event.target===menu)menu.close();});
              menu.addEventListener('close',function(){button.focus();});
              async function copyLink(app){
                try{if(!navigator.clipboard || !navigator.clipboard.writeText)throw new Error('Clipboard unavailable');await navigator.clipboard.writeText(url);status.textContent=app?'Enlace copiado. Pégalo en '+app+'.':'Enlace copiado.';}
                catch(error){input.value=url;manual.hidden=false;status.textContent=app?'Copia el enlace y pégalo en '+app+'.':'Copia el enlace del episodio:';input.focus();input.select();}
              }
              wrap.querySelector('[data-share-copy]').addEventListener('click',function(){copyLink('');});
              wrap.querySelectorAll('[data-share-app]').forEach(function(option){option.addEventListener('click',async function(){
                var app=option.getAttribute('data-share-app');status.textContent='';manual.hidden=true;
                if(navigator.share){status.textContent='Elige '+app+' en las opciones de compartir.';try{await navigator.share({title:title,url:url});return;}catch(error){if(error.name==='AbortError'){status.textContent='';return;}}}
                await copyLink(app);
              });});
            })();
            </script>
        </div>
    </section>

    <section class="quichi-post-layout gh-outer">
        <div class="gh-inner quichi-post-grid">

            <article class="quichi-post-main">

                <section class="quichi-platform-section" aria-labelledby="quichi-platform-title">
                    <div class="quichi-section-heading">
                        <span aria-hidden="true">[]</span>
                        <h2 id="quichi-platform-title">Episodio principal</h2>
                    </div>

                    <div class="quichi-platform-player" data-platform-player>
                        <div class="quichi-platform-placeholder">
                            Cargando episodio...
                        </div>
                    </div>

                    <div class="quichi-section-heading quichi-platform-heading">
                        <span aria-hidden="true">(o)</span>
                        <h2>Ver en otras plataformas</h2>
                    </div>

                    <p class="quichi-platform-help">Elige tu plataforma preferida para ver este episodio.</p>

                    <div class="quichi-platform-tabs" role="tablist" aria-label="Plataformas del episodio">
                        <button class="is-active" type="button" role="tab" aria-selected="true" data-platform-tab="youtube">YouTube</button>
                        <button type="button" role="tab" aria-selected="false" data-platform-tab="instagram">Instagram</button>
                        <button type="button" role="tab" aria-selected="false" data-platform-tab="tiktok">TikTok</button>
                        <button type="button" role="tab" aria-selected="false" data-platform-tab="facebook">Facebook</button>
                    </div>
                </section>

                <section id="quichi-audio" class="quichi-audio-panel">
                    <div class="quichi-section-heading">
                        <span aria-hidden="true">( )</span>
                        <h2>Escuchar narracion</h2>
                    </div>
                    <div class="quichi-audio-player" data-quichi-audio-player>
                        Agrega un bloque de audio en el contenido de Ghost para mostrar la narracion aqui.
                    </div>
                </section>

                <section class="quichi-post-content gh-content">
                    {{content}}
                </section>

                {{#if primary_tag}}
                    {{#get "posts" filter="tags:{{primary_tag.slug}}+id:-{{id}}" limit="30" include="tags"}}
                        {{#if posts}}
                            <section class="quichi-related-panel" aria-labelledby="related-stories-title">
                                <div class="quichi-section-heading">
                                    <span aria-hidden="true">/</span>
                                    <h2 id="related-stories-title">Archivos relacionados</h2>
                                </div>
                                <div class="quichi-related-grid">
                                    {{#foreach posts}}
                                        <a href="{{url}}" class="quichi-related-card">
                                            {{#if feature_image}}
                                                <img src="{{img_url feature_image size="s" format="webp"}}" alt="" loading="lazy" decoding="async">
                                            {{/if}}
                                            <span>{{title}}</span>
                                        </a>
                                    {{/foreach}}
                                </div>
                            </section>
                        {{/if}}
                    {{/get}}
                {{/if}}

                <style>
                    .post-template .quichi-related-grid { grid-template-columns: repeat(4, minmax(0, 1fr)) !important; }
                    .post-template .quichi-related-card img { aspect-ratio: 16 / 15.87 !important; }
                    .post-template .quichi-related-card:nth-child(n+5) { display: none !important; }
                    @media (max-width: 767px) {
                        .post-template .quichi-related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
                        .post-template .quichi-related-card:nth-child(n+3) { display: none !important; }
                    }
                    .post-template .quichi-related-card:focus-visible { outline: 2px solid #ff626a; outline-offset: 3px; }
                </style>

                <script>
                    (() => {
                        const panel = document.querySelector('.quichi-related-panel');
                        if (!panel) return;
                        const normalize = text => text.normalize('NFKC').trim().replace(/\s+/g, ' ').toLocaleLowerCase('es');
                        const title = document.querySelector('.quichi-post-hero h1');
                        const seen = new Set(title ? [normalize(title.textContent)] : []);
                        let kept = 0;
                        panel.querySelectorAll('.quichi-related-card').forEach(card => {
                            const key = normalize(card.textContent);
                            if (!key || seen.has(key) || kept >= 4) card.remove();
                            else { seen.add(key); kept++; }
                        });
                        if (!kept) panel.remove();
                    })();
                </script>

                {{#if comments}}
                    <section class="quichi-post-comments">
                        <h2>{{comment_count empty="" singular=(t "comment") plural=(t "comments")}}</h2>
                        {{comments title="" count=false}}
                    </section>
                {{/if}}

            </article>

            {{> "components/quichi-post-sidebar"}}

        </div>
    </section>

</main>

{{> "components/saved-stories-script"}}
{{> "components/reading-resume-script"}}

{{/post}}
