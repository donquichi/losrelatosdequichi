{{!< default}}

<main class="gh-main gh-outer">
    <div class="gh-inner">
        {{> "components/archive-discovery" currentTag=tag.slug}}
        {{#tag}}{{#match slug "scp-foundation"}}{{> "components/scp-welcome"}}{{else}}{{> "components/category-welcome"}}{{/match}}{{/tag}}
        {{> "components/list" layout="grid" column="4" slug=tag.slug count="all" showPrimaryTag=true showPublishedAt=true}}
    </div>
</main>
