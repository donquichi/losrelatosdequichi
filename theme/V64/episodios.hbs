{{!< default}}

<main class="gh-main gh-outer quichi-episodes-archive">
    <div class="gh-inner">
        <section class="gh-archive gh-outer">
            <div class="gh-archive-inner gh-inner">
                <header class="gh-archive-header">
                    <h1 class="gh-archive-title">Episodios</h1>
                    <p class="gh-archive-description">Explora todos los relatos de terror y misterio, desde los más recientes hasta los primeros expedientes.</p>
                </header>
            </div>
        </section>
        {{> "components/archive-discovery" all=true}}
        {{> "components/list" layout="grid" column="4" showPrimaryTag=true showPublishedAt=true hasPagination=true}}
    </div>
</main>
