{{!--
    Parameters:
    * navigationLayout ("Stacked", "Logo on the left", "Logo in the middle")
--}}

<style>
body.home-template header#gh-head.is-head-stacked .quichi-nav-links a[aria-current="page"]{color:#fff!important}
header#gh-head .quichi-start-link{position:relative;isolation:isolate}
@property --quichi-start-color{syntax:"<color>";inherits:false;initial-value:#fff}
@media(min-width:768px){body header#gh-head.is-head-stacked .quichi-desktop-menu .quichi-start-link{color:var(--quichi-start-color)!important;animation:quichi-desktop-red 5s ease-in-out infinite}header#gh-head .quichi-desktop-menu .quichi-start-link::before{animation:quichi-desktop-bolt 5s ease-in-out infinite}@keyframes quichi-desktop-bolt{0%,100%{opacity:.12}50%{opacity:.65}}@keyframes quichi-desktop-red{0%,100%{--quichi-start-color:#fff;text-shadow:none}50%{--quichi-start-color:#ff3038;text-shadow:0 0 8px #ff30388c}}}
@media(prefers-reduced-motion:reduce) and (min-width:768px){body header#gh-head.is-head-stacked .quichi-desktop-menu .quichi-start-link{animation:none;color:#fff!important;text-shadow:none}header#gh-head .quichi-desktop-menu .quichi-start-link::before{animation:none;opacity:.3}}
header#gh-head .quichi-start-link::before{content:"";position:absolute;z-index:-1;pointer-events:none;left:50%;top:50%;width:36px;height:47px;opacity:0;transform:translate(-50%,-50%);background:linear-gradient(145deg,#fff5f0,#ff8383 45%,#e50013);clip-path:polygon(54% 0,25% 47%,48% 45%,32% 100%,80% 34%,56% 38%,74% 0);filter:drop-shadow(0 0 7px #e50013)}
header#gh-head .quichi-start-link:hover::before,header#gh-head .quichi-start-link:focus-visible::before{animation:quichi-menu-bolt 1s ease-out}
@keyframes quichi-menu-bolt{0%,25%,45%,100%{opacity:0}12%,34%{opacity:.8}}
@media(prefers-reduced-motion:reduce){header#gh-head .quichi-start-link:hover::before,header#gh-head .quichi-start-link:focus-visible::before{animation:none;opacity:.35}}
@media(min-width:768px){body header#gh-head.is-head-stacked .gh-head-inner{height:auto!important}body header#gh-head.is-head-stacked .gh-head-actions{position:static!important;align-self:center!important;justify-content:center!important;width:auto!important;margin:0 auto 12px!important}}
header#gh-head .quichi-mobile-start{display:none!important}
@media(max-width:767px){body header#gh-head.is-head-stacked .gh-head-inner{height:auto!important}header#gh-head .quichi-mobile-start{display:inline-flex!important;align-items:center;justify-content:center;min-height:44px;margin:4px auto 0;padding:8px 14px;color:#fff!important;font-size:1.25rem;font-weight:800;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}header#gh-head .quichi-mobile-start:focus-visible{outline:2px solid #fff;outline-offset:3px}}
@media(max-width:767px){header#gh-head .quichi-mobile-start{position:relative;isolation:isolate}header#gh-head .quichi-mobile-start::before{content:"";position:absolute;z-index:-1;pointer-events:none;left:50%;top:50%;width:28px;height:38px;transform:translate(-50%,-50%);background:linear-gradient(145deg,#ffdbd4,#f04a51 55%,#a60010);clip-path:polygon(54% 0,25% 47%,48% 45%,32% 100%,80% 34%,56% 38%,74% 0);filter:drop-shadow(0 0 7px #cf1420);animation:quichi-mobile-bolt 5s ease-in-out infinite}@keyframes quichi-mobile-bolt{0%,100%{opacity:.12}50%{opacity:.65}}}
@media(prefers-reduced-motion:reduce){header#gh-head .quichi-mobile-start::before{animation:none;opacity:.3}}
@media(max-width:767px){header#gh-head .quichi-mobile-start-text{color:#fff;animation:quichi-mobile-red 5s ease-in-out infinite}@keyframes quichi-mobile-red{0%,100%{color:#fff;text-shadow:none}50%{color:#ff3038;text-shadow:0 0 8px #ff30388c}}}
@media(prefers-reduced-motion:reduce){header#gh-head .quichi-mobile-start-text{animation:none;color:#fff}}
header#gh-head .quichi-saved-icon{position:relative;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;flex:none;color:#fff!important;text-decoration:none}header#gh-head .quichi-saved-icon svg{width:21px;height:21px}header#gh-head .quichi-saved-icon:focus-visible{outline:3px solid #fff;outline-offset:2px}header#gh-head .quichi-saved-count{position:absolute;top:1px;right:1px;display:flex;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 4px;border-radius:9px;background:#b00017;color:#fff;font:700 11px/1 system-ui,sans-serif}header#gh-head .quichi-saved-count[hidden]{display:none}header#gh-head .gh-head-brand>.quichi-saved-icon{display:none}@media(max-width:767px){header#gh-head.is-head-stacked .gh-head-brand>.quichi-saved-icon{display:inline-flex;position:absolute;right:60px;top:50%;transform:translateY(-50%)}header#gh-head.is-head-stacked .gh-head-actions>.quichi-saved-icon{display:none}}
@media(max-width:360px){header#gh-head.is-head-stacked .gh-head-brand>.quichi-saved-icon{right:39px}header#gh-head.is-head-stacked .gh-head-brand>.gh-search{right:0!important}}
@media(min-width:768px){body header#gh-head.is-head-stacked .quichi-desktop-menu .quichi-start-link{color:var(--quichi-start-color,#fff)!important;font-weight:800;letter-spacing:.08em}header#gh-head .quichi-desktop-menu .quichi-start-link::before{width:28px;height:38px;background:linear-gradient(145deg,#ffdbd4,#f04a51 55%,#a60010);filter:drop-shadow(0 0 7px #cf1420)}}
</style>
<header id="gh-head" class="gh-head gh-outer is-head-stacked quichi-has-navigation{{#if isTransparent}} is-head-transparent{{/if}}">
    <div class="gh-head-inner{{#unless fullWidth}} gh-inner{{/unless}}">

        <div class="gh-head-brand">
            <div class="gh-head-brand-wrapper">
                <a class="gh-head-logo" href="{{@site.url}}">
                    {{#if @site.logo}}
                      <img class="quichi-main-logo" src="{{img_url @site.logo size="m" format="webp"}}" decoding="async" alt="{{@site.title}}">
                    {{else}}
                        {{@site.title}}
                    {{/if}}
                </a>
            </div>

            <a class="quichi-saved-icon" href="{{@site.url}}/guardados/" aria-label="Mis relatos guardados"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h12l4 4v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M7 3v6h10V3M7 21v-8h10v8"/><path d="M14 5v2"/></svg><span class="quichi-saved-count" aria-hidden="true" hidden></span></a>

            <button class="gh-search gh-icon-btn" aria-label="Buscar en el sitio" data-ghost-search>
                {{> "icons/search"}}
            </button>

        </div>

        <details class="quichi-mobile-menu">
            <summary aria-label="Menú principal">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                <span>Menú</span>
            </summary>
            <nav aria-label="Navegación móvil">
                <ul class="quichi-nav-links">{{> "components/navigation-links"}}</ul>
            </nav>
        </details>

        <nav class="gh-head-menu quichi-nav quichi-desktop-menu" aria-label="Navegación principal">
            <ul class="quichi-nav-links">{{> "components/navigation-links"}}</ul>
        </nav>

        <div class="gh-head-actions">
            <div class="quichi-social">

                <a href="https://www.youtube.com/@LosRelatosdeQuichi" target="_blank" rel="noopener" aria-label="YouTube">
                    {{> "icons/youtube"}}
                </a>

                <a href="https://www.facebook.com/losrelatosdequichi" target="_blank" rel="noopener" aria-label="Facebook">
                    {{> "icons/facebook"}}
                </a>

                <a href="https://www.instagram.com/losrelatosdequichi" target="_blank" rel="noopener" aria-label="Instagram">
                    {{> "icons/instagram"}}
                </a>

                <a href="https://www.tiktok.com/@losrelatosdequichi" target="_blank" rel="noopener" aria-label="TikTok">
                    {{> "icons/tiktok"}}
                </a>

            </div>

            <a class="quichi-saved-icon" href="{{@site.url}}/guardados/" aria-label="Mis relatos guardados"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h12l4 4v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M7 3v6h10V3M7 21v-8h10v8"/><path d="M14 5v2"/></svg><span class="quichi-saved-count" aria-hidden="true" hidden></span></a>

            <button class="gh-search gh-icon-btn" aria-label="Buscar en el sitio" data-ghost-search>
                {{> "icons/search"}}
            </button>
        </div>
        <a class="quichi-mobile-start" href="{{@site.url}}/empieza-aqui/"><span class="quichi-mobile-start-text">Empieza aquí</span></a>

    </div>
</header>
<script>
(function(){var links=document.querySelectorAll('#gh-head .quichi-saved-icon'),key='quichi-saved-episodes-v1';function update(){var count=0;try{var data=JSON.parse(localStorage.getItem(key)||'[]');if(Array.isArray(data))count=data.filter(function(item){try{return item&&typeof item.title==='string'&&!!item.url&&new URL(item.url,location.origin).origin===location.origin;}catch(error){return false;}}).length;}catch(error){}links.forEach(function(link){var badge=link.querySelector('.quichi-saved-count');badge.hidden=count===0;badge.textContent=count>99?'99+':String(count);link.setAttribute('aria-label',count?'Mis relatos guardados: '+count:'Mis relatos guardados');});}update();window.addEventListener('storage',function(event){if(event.key===key)update();});window.addEventListener('quichi:saved-change',update);})();
</script>
