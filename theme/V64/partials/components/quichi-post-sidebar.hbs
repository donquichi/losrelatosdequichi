<aside class="quichi-post-sidebar">

    <section class="quichi-post-sidebar-box quichi-post-metadata-card">
        <h3>Metadata</h3>

        <dl class="quichi-post-metadata">
            <div class="quichi-episode-metadata-row" data-quichi-meta-row="archivo">
                <dt>Archivo</dt>
                <dd data-quichi-meta-value="archivo"></dd>
            </div>

            <div class="quichi-episode-metadata-row" data-quichi-meta-row="clasificacion">
                <dt>Clasificacion</dt>
                <dd data-quichi-meta-value="clasificacion"></dd>
            </div>

            <div class="quichi-episode-metadata-row" data-quichi-meta-row="alias">
                <dt>Alias</dt>
                <dd data-quichi-meta-value="alias"></dd>
            </div>

            <div class="quichi-episode-metadata-row" data-quichi-meta-row="nombre">
                <dt>Nombre</dt>
                <dd data-quichi-meta-value="nombre"></dd>
            </div>

            <div class="quichi-episode-metadata-row" data-quichi-meta-row="origen">
                <dt>Origen</dt>
                <dd data-quichi-meta-value="origen"></dd>
            </div>

            {{#primary_tag}}
                <div class="quichi-category-metadata">
                    <dt>Categoria</dt>
                    <dd><a href="{{url}}">{{name}}</a></dd>
                </div>
            {{/primary_tag}}

            <div>
                <dt>Publicado</dt>
                <dd><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM, YYYY"}}</time></dd>
            </div>

            {{#if tags}}
                <div>
                    <dt>Etiquetas</dt>
                    <dd class="quichi-post-tags">
                        {{#foreach tags limit="4"}}
                            <a href="{{url}}">#{{slug}}</a>
                        {{/foreach}}
                    </dd>
                </div>
            {{/if}}
        </dl>
    </section>

    {{> "components/amazon-recommendations"}}

    <section class="quichi-post-sidebar-box quichi-social-stats">
        <h3>Sigueme</h3>

        <div class="quichi-social-stat-grid">
            <a href="https://www.youtube.com/@LosRelatosdeQuichi" target="_blank" rel="noopener">
                {{> "icons/youtube"}}
                <strong>LosRelatosdeQuichi</strong>
                <span>YouTube</span>
            </a>

            <a href="https://www.facebook.com/losrelatosdequichi" target="_blank" rel="noopener">
                {{> "icons/facebook"}}
                <strong>LosRelatosdeQuichi</strong>
                <span>Facebook</span>
            </a>

            <a href="https://www.instagram.com/losrelatosdequichi" target="_blank" rel="noopener">
                {{> "icons/instagram"}}
                <strong>LosRelatosdeQuichi</strong>
                <span>Instagram</span>
            </a>

            <a href="https://www.tiktok.com/@losrelatosdequichi" target="_blank" rel="noopener">
                {{> "icons/tiktok"}}
                <strong>LosRelatosdeQuichi</strong>
                <span>TikTok</span>
            </a>
        </div>
    </section>

    <section class="quichi-post-sidebar-box quichi-post-popular">
        <h3>Descubre otros relatos</h3>

        <div class="quichi-post-popular-list">
            {{#get "posts" limit="5" filter="id:-{{id}}" include="tags" order="published_at desc"}}
                {{#foreach posts}}
                    <a href="{{url}}" class="quichi-post-popular-item {{#unless feature_image}}no-image{{/unless}}">
                        <span class="quichi-post-popular-number">{{@number}}</span>

                        {{#if feature_image}}
                            <img src="{{img_url feature_image size="s" format="webp"}}" alt="{{title}}" loading="lazy" decoding="async">
                        {{/if}}

                        <strong>{{title}}</strong>
                    </a>
                {{/foreach}}
            {{/get}}
        </div>

    </section>

    <section class="quichi-post-sidebar-box quichi-post-categories">
        <h3>Categorias</h3>

        <div class="quichi-post-category-list">
            {{#get "tags" include="count.posts" order="name asc" limit="100"}}
                {{#foreach tags}}
                    <a href="{{url}}" class="quichi-post-category-row quichi-category-{{slug}}">
                        <span>{{name}}</span>
                        <small>{{count.posts}} episodios</small>
                    </a>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

</aside>
