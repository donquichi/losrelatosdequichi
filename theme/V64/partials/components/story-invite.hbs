<style>
.quichi-story-invite{margin:38px 0;padding:27px;border:1px solid #583037;background:#160f10;color:#eee}.home-template .quichi-story-invite{max-width:360px;padding:20px;margin:28px 0}.home-template .quichi-story-invite h2{font-size:24px}.quichi-story-invite h2{margin:0 0 10px;color:#f5f1ef!important;font:700 clamp(24px,3vw,32px)/1.15 Georgia,serif}.quichi-story-invite p{margin:0 0 17px;color:#d7cbca;font:16px/1.5 Georgia,serif}.quichi-story-invite a{display:inline-flex;align-items:center;min-height:44px;padding:11px 19px;background:#a90013;border:1px solid #d15158;color:#fff!important;font:700 12px system-ui,sans-serif;letter-spacing:.05em;text-decoration:none;text-transform:uppercase}.quichi-story-invite a:focus-visible{outline:3px solid #fff;outline-offset:3px}@media(max-width:560px){.quichi-story-invite{padding:22px;margin:28px 0}}
.quichi-story-form textarea{display:block;box-sizing:border-box;width:100%;min-height:135px;resize:vertical;margin:12px 0;background:#090909;border:1px solid #735456;color:#fff;padding:11px;font:16px/1.45 system-ui,sans-serif}.quichi-story-form button{min-height:44px;padding:11px 20px;background:#a90013;border:1px solid #d15158;color:#fff;font:700 12px system-ui,sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer}.quichi-story-form textarea:focus-visible,.quichi-story-form button:focus-visible{outline:3px solid #fff;outline-offset:3px}.quichi-story-form .quichi-story-label{display:block;font:14px system-ui,sans-serif;color:#ded4d3}.quichi-story-form .quichi-story-result{font:14px/1.45 system-ui,sans-serif;color:#fff;margin:12px 0 0}.quichi-story-form button:disabled{opacity:.65;cursor:wait}.quichi-story-form .quichi-story-note{font:12px/1.45 system-ui,sans-serif;color:#c2b5b5;margin:10px 0 0}
</style>
<section class="quichi-story-invite" aria-labelledby="quichi-story-invite-title">
  {{#is "home"}}
  <h2 id="quichi-story-invite-title">¿Quieres contar un relato?</h2>
  <form class="quichi-story-form" action="https://formspree.io/f/xnpdjekp" method="POST">
    <label class="quichi-story-label" for="quichi-story-text">Envíanos tu relato</label>
    <textarea id="quichi-story-text" name="relato" placeholder="Escribe tu relato aquí" required maxlength="15000"></textarea>
    <button type="submit">Enviar</button>
    <p class="quichi-story-note">Tu relato se envía para revisión privada y no se publica automáticamente.</p>
    <p class="quichi-story-result" role="status" aria-live="polite" hidden></p>
  </form>
  <script>
  (function(){
    var form=document.querySelector(".quichi-story-form");
    if(!form || !window.fetch || !window.FormData) return;
    var button=form.querySelector("button"), status=form.querySelector(".quichi-story-result");
    form.addEventListener("submit",async function(event){
      event.preventDefault();
      if(button.disabled) return;
      button.disabled=true; button.textContent="Enviando…"; status.hidden=true;
      try {
        var response=await fetch(form.action,{method:"POST",body:new FormData(form),headers:{"Accept":"application/json"}});
        if(!response.ok || response.redirected) throw new Error("Submission failed");
        var result=await response.json();
        if(!result.ok) throw new Error("Submission not confirmed");
        form.reset(); status.textContent="¡Gracias! Tu relato fue enviado.";
      } catch(error) { status.textContent="No se pudo enviar. Inténtalo de nuevo."; }
      status.hidden=false; button.disabled=false; button.textContent="Enviar";
    });
  })();
  </script>
  {{else}}
  <h2 id="quichi-story-invite-title">¿Tienes una historia que contar?</h2>
  <p>Cuéntame tu relato y podría convertirse en un video narrado de Los Relatos de Quichi.</p>
  <a href="{{@site.url}}/cuentame-tu-relato/">Cuéntame tu relato <span aria-hidden="true">&nbsp;→</span></a>
  {{/is}}
</section>
