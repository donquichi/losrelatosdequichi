<style>
.quichi-scp-welcome{padding:28px 0 38px;border-bottom:1px solid #3b292c}.quichi-scp-welcome .scp-eyebrow{margin:0 0 10px;color:#ff7379;font:700 12px/1.4 system-ui,sans-serif;letter-spacing:.15em;text-transform:uppercase}.quichi-scp-welcome #scp-intro-title{margin:0 0 12px;color:#f5f1ef;font:400 clamp(30px,4vw,46px)/1.1 Georgia,serif}.quichi-scp-welcome>p:not(.scp-eyebrow){max-width:720px;margin:0 0 20px;color:#d6cccc;font:18px/1.55 Georgia,serif}.scp-all-link{display:inline-flex;min-height:44px;align-items:center;justify-content:center;text-align:center;line-height:1.4;overflow-wrap:anywhere;padding:12px 20px;border:1px solid #d15158;background:#a60013;color:#fff!important;text-decoration:none;font:700 12px system-ui,sans-serif;text-transform:uppercase;letter-spacing:.04em}.scp-recommended-heading{margin:34px 0 14px;color:#f5f1ef;font:400 25px Georgia,serif}.scp-recommended{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.scp-recommended-card{display:flex;gap:16px;min-width:0;padding:16px;border:1px solid #513238;background:#151011;color:#f5f1ef!important;text-decoration:none}.scp-recommended-card img{width:90px;height:108px;object-fit:cover;flex:none}.scp-recommended-card small{color:#ff7777;font:700 11px system-ui,sans-serif;letter-spacing:.08em}.scp-recommended-card h3{margin:9px 0;color:#fff;font:700 19px/1.25 Georgia,serif}.scp-recommended-card span{color:#ff7777;font:700 12px system-ui,sans-serif}.quichi-scp-welcome a:focus-visible{outline:3px solid white;outline-offset:3px}.scp-all-heading{margin:40px 0 0;color:#ff7777;font:700 14px system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;scroll-margin-top:20px}@media(max-width:600px){.quichi-scp-welcome{padding:24px 0 30px}.quichi-scp-welcome>p:not(.scp-eyebrow){font-size:16px}.scp-all-link{width:100%}.scp-recommended{grid-template-columns:1fr}.scp-recommended-card img{width:76px;height:90px}.scp-recommended-card h3{font-size:17px}}

@media(max-width:767px){
  body.tag-scp-foundation .gh-list.grid .gh-list-feed{display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:0!important}
  body.tag-scp-foundation .gh-list-feed .quichi-episode-card{min-width:0!important;margin:0!important;border-bottom:1px solid #30282a!important}
  body.tag-scp-foundation .gh-list-feed .quichi-episode-card-inner{display:grid!important;grid-template-columns:76px minmax(0,1fr)!important;grid-template-rows:auto auto!important;column-gap:14px!important;row-gap:5px!important;align-items:start!important;padding:14px 0!important;text-align:left!important}
  body.tag-scp-foundation .gh-list-feed .quichi-episode-card-image{grid-column:1!important;grid-row:1 / 3!important;width:76px!important;height:96px!important;min-width:0!important;margin:0!important;overflow:hidden!important}
  body.tag-scp-foundation .gh-list-feed .quichi-episode-card-image img{display:block!important;width:100%!important;height:100%!important;object-fit:cover!important}
  body.tag-scp-foundation .gh-list-feed .quichi-episode-card-content{grid-column:2!important;grid-row:1!important;min-width:0!important;margin:0!important;padding:0!important;text-align:left!important}
  body.tag-scp-foundation .gh-list-feed .quichi-episode-card-title{font:700 15px/1.3 system-ui,sans-serif!important;margin:5px 0!important;overflow-wrap:anywhere!important}
  body.tag-scp-foundation .gh-list-feed .quichi-episode-card-tag{font:700 10px/1.3 system-ui,sans-serif!important;letter-spacing:.04em!important}
  body.tag-scp-foundation .gh-list-feed .quichi-episode-card-meta{font:12px/1.3 Georgia,serif!important;margin:0!important}
  body.tag-scp-foundation .gh-list-feed .quichi-episode-card-button{grid-column:2!important;grid-row:2!important;justify-self:start!important;align-self:end!important;margin:0!important;font:700 12px/1.3 Georgia,serif!important}
}
</style>
<section class="quichi-scp-welcome" aria-labelledby="scp-intro-title">
  <p class="scp-eyebrow">Archivos clasificados · SCP en español</p>
  <h1 id="scp-intro-title">Entra al mundo SCP</h1>
  <p>Objetos imposibles, criaturas inexplicables y expedientes que nunca debieron salir a la luz. Descubre los relatos SCP narrados por Quichi.</p>
  <a class="scp-all-link" href="#todos-los-expedientes">Ver todos: {{name}} ↓</a>
  <h3 class="scp-recommended-heading">Dos relatos para empezar</h3>
  <div class="scp-recommended">
    {{#get "posts" filter="slug:scp-020-el-hongo-que-solo-aparece-en-las-grabaciones+tag:scp-foundation" limit="1"}}
      {{#foreach posts}}<a class="scp-recommended-card" href="{{url}}">{{#if feature_image}}<img src="{{img_url feature_image size="s" format="webp"}}" alt="" loading="lazy">{{/if}}<div><small>EXPEDIENTE SCP-020</small><h3>{{title}}</h3><span>Ver episodio →</span></div></a>{{/foreach}}
    {{/get}}
    {{#get "posts" filter="slug:scp-426-soy-una-tostadora-y-no-puedes-hablar-de-mi-normalmente+tag:scp-foundation" limit="1"}}
      {{#foreach posts}}<a class="scp-recommended-card" href="{{url}}">{{#if feature_image}}<img src="{{img_url feature_image size="s" format="webp"}}" alt="" loading="lazy">{{/if}}<div><small>EXPEDIENTE SCP-426</small><h3>{{title}}</h3><span>Ver episodio →</span></div></a>{{/foreach}}
    {{/get}}
  </div>
</section>
<h2 id="todos-los-expedientes" class="scp-all-heading">Todos los expedientes</h2>

<script>
(function(){
  function chooseStories(){
    var target=document.querySelector('.scp-recommended');
    var entries=Array.from(document.querySelectorAll('.gh-list-feed .gh-list-item')).map(function(card){var link=card.querySelector('a[href]'),title=card.querySelector('.gh-list-item-title'),img=card.querySelector('img');return link&&title?{href:link.href,title:title.textContent.trim(),image:img}:null;}).filter(Boolean);
    if(!target||entries.length<2)return;
    var last=[];try{last=JSON.parse(sessionStorage.getItem('quichi-scp-last')||'[]');if(!Array.isArray(last))last=[];}catch(error){}
    var pool=entries.filter(function(entry){return last.indexOf(entry.href)<0;});if(pool.length<2)pool=entries.slice();
    for(var i=pool.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),tmp=pool[i];pool[i]=pool[j];pool[j]=tmp;}
    var selected=pool.slice(0,2),fragment=document.createDocumentFragment();
    selected.forEach(function(story){
      var link=document.createElement('a');link.className='scp-recommended-card';link.href=story.href;
      if(story.image){var img=story.image.cloneNode(false);img.alt='';img.loading='lazy';link.appendChild(img);}
      var content=document.createElement('div'),label=document.createElement('small'),title=document.createElement('h3'),action=document.createElement('span');
      label.textContent='EXPEDIENTE SCP';title.textContent=story.title;action.textContent='Ver episodio →';content.append(label,title,action);link.appendChild(content);fragment.appendChild(link);
    });
    target.replaceChildren(fragment);try{sessionStorage.setItem('quichi-scp-last',JSON.stringify(selected.map(function(story){return story.href;})));}catch(error){}
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',chooseStories,{once:true});else chooseStories();
})();
</script>
