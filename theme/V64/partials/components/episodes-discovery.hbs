<style>
.qe-discover{padding:10px 0 36px;border-bottom:1px solid #3b292c}.qe-discover .qe-kicker{color:#ff7379;font:700 12px system-ui,sans-serif;letter-spacing:.15em;text-transform:uppercase}.qe-discover h2{margin:10px 0;color:#f5f1ef;font:400 clamp(28px,4vw,40px)/1.15 Georgia,serif}.qe-discover .qe-all{display:inline-flex;min-height:44px;align-items:center;justify-content:center;text-align:center;margin:12px 0 25px;padding:12px 20px;background:#a60013;border:1px solid #d15158;color:#fff!important;text-decoration:none;font:700 12px system-ui,sans-serif;letter-spacing:.04em;text-transform:uppercase}.qe-search{display:inline-flex;align-items:center;min-height:44px;margin-left:12px;color:#ff8888!important;font:700 12px system-ui,sans-serif;text-decoration:underline}.qe-featured{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.qe-featured a{display:flex;gap:16px;min-width:0;padding:16px;border:1px solid #513238;background:#151011;color:#f5f1ef!important;text-decoration:none}.qe-featured img{width:90px;height:108px;object-fit:cover;flex:none}.qe-featured small{color:#ff7777;font:700 11px system-ui,sans-serif;letter-spacing:.08em}.qe-featured h3{margin:9px 0;color:#fff;font:700 19px/1.25 Georgia,serif}.qe-featured span{color:#ff7777;font:700 12px system-ui,sans-serif}.qe-categories{padding:34px 0;border-bottom:1px solid #3b292c}.qe-categories h2,.qe-all-title{margin:0 0 18px;color:#ff7777;font:700 14px system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase}.qe-category-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.qe-category{position:relative;min-height:100px;display:flex;align-items:flex-end;padding:14px;overflow:hidden;border:1px solid #3a2a2c;background:#171213;color:#fff!important;text-decoration:none}.qe-category img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.4}.qe-category:before{content:'';position:absolute;inset:0;background:linear-gradient(transparent,#000c)}.qe-category span{position:relative;font:700 12px/1.35 system-ui,sans-serif;text-transform:uppercase}.qe-all-title{margin-top:38px;scroll-margin-top:20px}.quichi-episodes-archive a:focus-visible{outline:3px solid white;outline-offset:3px}@media(max-width:767px){.qe-featured{grid-template-columns:1fr}.qe-featured img{width:76px;height:90px}.qe-featured h3{font-size:17px}.qe-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.qe-all{width:100%}}
@media(max-width:767px){
  body .quichi-episodes-archive .gh-list.grid .gh-list-feed{display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:0!important}
  body .quichi-episodes-archive .gh-list-feed .quichi-episode-card{min-width:0!important;margin:0!important;border-bottom:1px solid #30282a!important}
  body .quichi-episodes-archive .gh-list-feed .quichi-episode-card-inner{display:grid!important;grid-template-columns:76px minmax(0,1fr)!important;grid-template-rows:auto auto!important;column-gap:14px!important;row-gap:5px!important;align-items:start!important;padding:14px 0!important;text-align:left!important}
  body .quichi-episodes-archive .gh-list-feed .quichi-episode-card-image{grid-column:1!important;grid-row:1 / 3!important;width:76px!important;height:96px!important;min-width:0!important;margin:0!important;overflow:hidden!important}
  body .quichi-episodes-archive .gh-list-feed .quichi-episode-card-image img{display:block!important;width:100%!important;height:100%!important;object-fit:cover!important}
  body .quichi-episodes-archive .gh-list-feed .quichi-episode-card-content{grid-column:2!important;grid-row:1!important;min-width:0!important;margin:0!important;padding:0!important;text-align:left!important}
  body .quichi-episodes-archive .gh-list-feed .quichi-episode-card-title{font:700 15px/1.3 system-ui,sans-serif!important;margin:5px 0!important;overflow-wrap:anywhere!important}
  body .quichi-episodes-archive .gh-list-feed .quichi-episode-card-tag{font:700 10px/1.3 system-ui,sans-serif!important;letter-spacing:.04em!important}
  body .quichi-episodes-archive .gh-list-feed .quichi-episode-card-meta{font:12px/1.3 Georgia,serif!important;margin:0!important}
  body .quichi-episodes-archive .gh-list-feed .quichi-episode-card-button{grid-column:2!important;grid-row:2!important;justify-self:start!important;align-self:end!important;margin:0!important;font:700 12px/1.3 Georgia,serif!important}
}

.qe-category{background-position:center;background-size:cover;background-repeat:no-repeat}
.qe-category-archivo-contagios{background-image:url('{{asset "png/1.webp"}}')}
.qe-category-casos-oscuros-desapariciones{background-image:url('{{asset "png/9.webp"}}')}
.qe-category-encuentros-extraterrestres{background-image:url('{{asset "png/10.webp"}}')}
.qe-category-espacios-liminales{background-image:url('{{asset "png/5.webp"}}')}
.qe-category-expedientes-clasificados{background-image:url('{{asset "png/7.webp"}}')}
.qe-category-expedientes-paranormales{background-image:url('{{asset "png/3.webp"}}')}
.qe-category-horror-analogico{background-image:url('{{asset "png/2.webp"}}')}
.qe-category-horror-maritimo{background-image:url('{{asset "png/4.webp"}}')}
.qe-category-horror-psicologico{background-image:url('{{asset "png/6.webp"}}')}
.qe-category-scp-foundation{background-image:url('{{asset "png/8.webp"}}')}
</style>
<section class="qe-discover" aria-labelledby="qe-discover-title">
  <p class="qe-kicker">Historias de terror y misterio</p><h2 id="qe-discover-title">Encuentra tu próximo relato</h2>
  <a class="qe-all" href="#todos-los-episodios">Ver todos los episodios ↓</a>
  <a class="qe-search" href="#/search" data-ghost-search>Buscar episodios</a>
  <a class="qe-search" href="{{@site.url}}/guardados/">Mis relatos guardados</a>
  <h2>Dos relatos para empezar</h2>
  <div class="qe-featured">
    {{#get "posts" limit="2" include="tags"}}{{#foreach posts}}<a href="{{url}}">{{#if feature_image}}<img src="{{img_url feature_image size="s" format="webp"}}" alt="" loading="lazy">{{/if}}<div><small>RELATO DESTACADO</small><h3>{{title}}</h3><span>Ver episodio →</span></div></a>{{/foreach}}{{/get}}
  </div>
</section>
<section class="qe-categories" aria-labelledby="qe-categories-title"><h2 id="qe-categories-title">Explora por categoría</h2><div class="qe-category-grid">
  {{#get "tags" include="count.posts" filter="visibility:public" order="name asc" limit="all"}}{{#foreach tags}}{{#if count.posts}}<a class="qe-category qe-category-{{slug}}" href="{{url}}">{{#if feature_image}}<img src="{{img_url feature_image size="s" format="webp"}}" alt="" loading="lazy">{{/if}}<span>{{name}} →</span></a>{{/if}}{{/foreach}}{{/get}}
</div></section>
<h2 class="qe-all-title" id="todos-los-episodios">Todos los episodios</h2>
<script>
(function(){function choose(){var target=document.querySelector('.qe-featured');var entries=Array.from(document.querySelectorAll('.gh-list-feed .gh-list-item')).map(function(card){var link=card.querySelector('a[href]'),title=card.querySelector('.gh-list-item-title'),img=card.querySelector('img');return link&&title?{href:link.href,title:title.textContent.trim(),image:img}:null;}).filter(Boolean);if(!target||entries.length<2)return;var last=[];try{last=JSON.parse(sessionStorage.getItem('quichi-all-episodes-last')||'[]');if(!Array.isArray(last))last=[];}catch(error){}var pool=entries.filter(function(entry){return last.indexOf(entry.href)<0;});if(pool.length<2)pool=entries.slice();for(var i=pool.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),tmp=pool[i];pool[i]=pool[j];pool[j]=tmp;}var selected=pool.slice(0,2),fragment=document.createDocumentFragment();selected.forEach(function(story){var link=document.createElement('a');link.href=story.href;if(story.image){var img=story.image.cloneNode(false);img.alt='';img.loading='lazy';link.appendChild(img);}var content=document.createElement('div'),label=document.createElement('small'),title=document.createElement('h3'),action=document.createElement('span');label.textContent='RELATO DESTACADO';title.textContent=story.title;action.textContent='Ver episodio →';content.append(label,title,action);link.appendChild(content);fragment.appendChild(link);});target.replaceChildren(fragment);try{sessionStorage.setItem('quichi-all-episodes-last',JSON.stringify(selected.map(function(story){return story.href;})));}catch(error){}}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',choose,{once:true});else choose();})();
</script>
