{{!< default}}

{{#get "posts" limit="13" include="tags" order="published_at desc" as |homepage_posts|}}

<main class="gh-main">

    <style>
        .quichi-category-card.quichi-category-mitos-rurales img,
        .quichi-category-card.quichi-category-objetos-malditos img { transform:scale(1.45); transform-origin:center top; }
    </style>

    <section class="quichi-featured gh-outer">
        <div class="gh-inner quichi-featured-inner">

                {{#foreach homepage_posts to="3"}}

                    <article class="quichi-slide {{#if feature_image}}has-image{{/if}}" style="{{#if feature_image}}background-image:url('{{img_url feature_image size="l" format="webp"}}'){{/if}}">

                        <div class="quichi-overlay"></div>

                        {{#if feature_image}}
                            <div class="quichi-slide-media">
                                <img src="{{img_url feature_image size="l" format="webp"}}" alt="{{title}}" decoding="async" loading="{{#if @first}}eager{{else}}lazy{{/if}}" fetchpriority="{{#if @first}}high{{else}}low{{/if}}">
                            </div>
                        {{/if}}

                        <div class="quichi-content">

                            {{#primary_tag}}
                                <span class="quichi-tag">{{name}}</span>
                            {{/primary_tag}}

                            <h1>{{title}}</h1>

                            <div class="quichi-hero-actions">
                                <a href="{{url}}" class="quichi-button">Ver episodio</a>
                            </div>

                        </div>

                    </article>

                {{/foreach}}


        </div>
    </section>

    <section class="quichi-home-layout gh-outer">
        <div class="gh-inner quichi-home-grid">

            <div class="quichi-home-main">


                <section class="quichi-latest-block">
                    <h2>Últimos episodios</h2>

                    <div class="quichi-episode-list">
                            {{#foreach homepage_posts to="5"}}
                                <article class="quichi-episode-row">
                                    {{#if feature_image}}
                                        <a href="{{url}}" class="quichi-row-image">
                                            <img src="{{img_url feature_image size="s" format="webp"}}" alt="{{title}}" loading="lazy" decoding="async">
                                            <span class="quichi-play small">Ver</span>
                                        </a>
                                    {{/if}}

                                    <div class="quichi-row-content">
                                        <h3><a href="{{url}}">{{title}}</a></h3>

                                        <div class="quichi-meta">
                                            <span>{{date format="D MMM, YYYY"}}</span>
                                            {{#primary_tag}}<span>{{name}}</span>{{/primary_tag}}
                                        </div>
                                    </div>

                                    <a href="{{url}}" class="quichi-row-button">Ver episodio</a>
                                </article>
                            {{/foreach}}

                    </div>
                </section>

                <section id="categorias" class="quichi-category-block">
                    <h2>Categorías</h2>

                    <div class="quichi-category-grid">
                        {{#get "tags" include="count.posts" order="name asc" limit="100"}}
                            {{#foreach tags}}
                                <a href="{{url}}" class="quichi-category-card quichi-category-{{slug}} {{#unless feature_image}}no-image{{/unless}}">
                                    {{#if feature_image}}
                                        <img src="{{img_url feature_image size="s" format="webp"}}" alt="{{name}}" loading="lazy" decoding="async">
                                    {{/if}}

                                    <span>{{name}}</span>
                                    <small>Ver más</small>
                                </a>
                            {{/foreach}}
                        {{/get}}
                        {{#get "posts" filter="tag:mitos-rurales" limit="1"}}
                            {{#unless posts}}
                                <a href="{{@site.url}}/categorias/mitos-rurales/" class="quichi-category-card quichi-category-mitos-rurales">
                                    <img src="{{img_url "https://losrelatosdequichi.com/content/images/2026/11/mitos-rurales.png" size="s" format="webp"}}" alt="" loading="lazy" decoding="async">
                                    <span>Mitos Rurales</span><small>Ver más</small>
                                </a>
                            {{/unless}}
                        {{/get}}
                        {{#get "posts" filter="tag:objetos-malditos" limit="1"}}
                            {{#unless posts}}
                                <a href="{{@site.url}}/categorias/objetos-malditos/" class="quichi-category-card quichi-category-objetos-malditos">
                                    <img src="{{img_url "https://losrelatosdequichi.com/content/images/2026/11/objetos-malditos.png" size="s" format="webp"}}" alt="" loading="lazy" decoding="async">
                                    <span>Objetos Malditos</span><small>Ver más</small>
                                </a>
                            {{/unless}}
                        {{/get}}
                    </div>
                </section>

                <section class="quichi-explore-block" aria-labelledby="quichi-explore-title">
                    <h2 id="quichi-explore-title">Sigue explorando</h2>
                    <p>Tu próximo relato te espera. Recorre el archivo o entra en el universo SCP.</p>
                    <div class="quichi-explore-links">
                        <a href="{{@site.url}}/episodios/">Todos los episodios <span aria-hidden="true">→</span></a>
                        <a href="{{@site.url}}/tag/scp-foundation/">SCP en español <span aria-hidden="true">→</span></a>
                        <a href="{{@site.url}}/sobre-mi/">Conoce a Quichi <span aria-hidden="true">→</span></a>
                    </div>
                </section>
                {{! Future advertising belongs below this section, separate from episode links.
                    No ad scripts or empty ad boxes are rendered until a real account is configured. }}
            </div>

            <aside class="quichi-home-sidebar">

                <div class="quichi-sidebar-box quichi-home-popular">
                    <h3>Descubre otros relatos</h3>

                    <div class="quichi-popular-list">
                            {{#foreach homepage_posts from="9" to="13"}}
                                <a href="{{url}}" class="quichi-popular-item {{#unless feature_image}}no-image{{/unless}}">
                                    <span class="quichi-popular-number" aria-hidden="true"></span>

                                    {{#if feature_image}}
                                        <img src="{{img_url feature_image size="s" format="webp"}}" alt="{{title}}" loading="lazy" decoding="async">
                                    {{/if}}

                                    <strong>{{title}}</strong>
                                </a>
                            {{/foreach}}
                    </div>

                </div>

                {{> "components/amazon-recommendations"}}
            </aside>

        </div>
    </section>

</main>

{{/get}}
