{{!< default}}

<main class="gh-main">

    <section class="quichi-featured gh-outer">
        <div class="gh-inner quichi-featured-inner">

            {{#get "posts" limit="3" include="tags"}}
                {{#foreach posts}}

                    <article class="quichi-slide {{#if feature_image}}has-image{{/if}}" style="{{#if feature_image}}background-image:url('{{img_url feature_image size="xxl"}}'){{/if}}">

                        <div class="quichi-overlay"></div>

                        {{#if feature_image}}
                            <div class="quichi-slide-media">
                                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
                            </div>
                        {{/if}}

                        <div class="quichi-content">

                            {{#primary_tag}}
                                <span class="quichi-tag">{{name}}</span>
                            {{/primary_tag}}

                            <h1>{{title}}</h1>

                            <div class="quichi-hero-actions">
                                <a href="{{url}}" class="quichi-button">Ver episodio</a>
                            </div>

                        </div>

                    </article>

                {{/foreach}}
            {{/get}}

        </div>
    </section>

    <section class="quichi-home-layout gh-outer">
        <div class="gh-inner quichi-home-grid">

            <div class="quichi-home-main">

                {{#get "posts" limit="1" include="tags"}}
                    {{#foreach posts}}
                        <section class="quichi-feature-block">
                            <h2>Episodio destacado</h2>

                            <article class="quichi-feature-episode">
                                {{#if feature_image}}
                                    <a href="{{url}}" class="quichi-feature-image">
                                        <img src="{{img_url feature_image size="m"}}" alt="{{title}}">
                                        <span class="quichi-play">Play</span>
                                    </a>
                                {{/if}}

                                <div class="quichi-feature-info">
                                    {{#primary_tag}}
                                        <span class="quichi-tag">{{name}}</span>
                                    {{/primary_tag}}

                                    <h3><a href="{{url}}">{{title}}</a></h3>

                                    <div class="quichi-meta">
                                        <span>{{date format="D MMM, YYYY"}}</span>
                                        {{#primary_tag}}<span>{{name}}</span>{{/primary_tag}}
                                    </div>

                                    <a href="{{url}}" class="quichi-outline-button">Leer mas</a>
                                </div>
                            </article>
                        </section>
                    {{/foreach}}
                {{/get}}

                <section class="quichi-category-block">
                    <h2>Categorias</h2>

                    <div class="quichi-category-grid">
                        {{#get "tags" include="count.posts" order="name asc" limit="10"}}
                            {{#foreach tags}}
                                <a href="{{url}}" class="quichi-category-card quichi-category-{{slug}} {{#unless feature_image}}no-image{{/unless}}">
                                    {{#if feature_image}}
                                        <img src="{{img_url feature_image size="s"}}" alt="{{name}}">
                                    {{/if}}

                                    <span>{{name}}</span>
                                    <small>Ver mas</small>
                                </a>
                            {{/foreach}}
                        {{/get}}
                    </div>
                </section>

                <section class="quichi-latest-block">
                    <h2>Ultimos episodios</h2>

                    <div class="quichi-episode-list">
                        {{#get "posts" limit="5" include="tags" filter="featured:false"}}
                            {{#foreach posts}}
                                <article class="quichi-episode-row">
                                    {{#if feature_image}}
                                        <a href="{{url}}" class="quichi-row-image">
                                            <img src="{{img_url feature_image size="s"}}" alt="{{title}}">
                                            <span class="quichi-play small">Play</span>
                                        </a>
                                    {{/if}}

                                    <div class="quichi-row-content">
                                        <h3><a href="{{url}}">{{title}}</a></h3>

                                        <div class="quichi-meta">
                                            <span>{{date format="D MMM, YYYY"}}</span>
                                            {{#primary_tag}}<span>{{name}}</span>{{/primary_tag}}
                                        </div>
                                    </div>

                                    <a href="{{url}}" class="quichi-row-button">Ver episodio</a>
                                </article>
                            {{/foreach}}
                        {{/get}}
                    </div>
                </section>

            </div>

            <aside class="quichi-home-sidebar">

                <div class="quichi-sidebar-box quichi-home-popular">
                    <h3>Episodios populares</h3>

                    <div class="quichi-popular-list">
                        {{#get "posts" limit="all" include="tags"}}
                            {{#foreach posts}}
                                <a href="{{url}}" class="quichi-popular-item {{#unless feature_image}}no-image{{/unless}}">
                                    <span class="quichi-popular-number"></span>

                                    {{#if feature_image}}
                                        <img src="{{img_url feature_image size="s"}}" alt="{{title}}">
                                    {{/if}}

                                    <strong>{{title}}</strong>
                                </a>
                            {{/foreach}}
                        {{/get}}
                    </div>

                    <script>
                        (function () {
                            var list = document.currentScript.previousElementSibling;

                            if (!list) {
                                return;
                            }

                            var items = Array.prototype.slice.call(list.querySelectorAll(".quichi-popular-item"));

                            list.innerHTML = "";

                            for (var index = items.length - 1; index > 0; index -= 1) {
                                var randomIndex = Math.floor(Math.random() * (index + 1));
                                var current = items[index];
                                items[index] = items[randomIndex];
                                items[randomIndex] = current;
                            }

                            items.forEach(function (item, index) {
                                if (index < 5) {
                                    var number = item.querySelector(".quichi-popular-number");

                                    if (number) {
                                        number.textContent = index + 1;
                                    }

                                    list.appendChild(item);
                                }
                            });
                        }());
                    </script>
                </div>

            </aside>

        </div>
    </section>

</main>
